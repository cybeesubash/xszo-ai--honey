# CYBER-EYE Environment Configuration
# Copy to backend/.env and fill in your values

# OpenRouter API (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Google Gemini API — https://aistudio.google.com/apikey (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Shared secret for ESP32 → backend authentication
HONEYPOT_API_KEY=change-me-to-a-strong-random-secret

# Telegram Bot alerts (high/critical severity only)
# See README for bot creation guide
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated dashboard origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLite default; use postgresql:// for production)
DATABASE_URL=sqlite:///./cyber_eye.db
