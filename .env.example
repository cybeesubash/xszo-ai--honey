# CYBER-EYE Platform Environment Variables
# Copy to backend/.env and configure all values

# ── Google Gemini AI ──────────────────────────────────────────────
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── ESP32 Device Authentication ─────────────────────────────────
# Must match the API key configured on the ESP32 (via config portal)
HONEYPOT_API_KEY=change-me-to-a-strong-random-secret

# ── Telegram Alerts (high/critical only) ──────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Backend Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=sqlite:///./cyber_eye.db

# ── Dashboard (dashboard/.env.local) ─────────────────────────────
# VITE_API_URL=http://localhost:8000
